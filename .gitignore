# Quase tudo que foi usado na auditoria está versionado. Fica de fora só o que passa dos limites do GitHub
# e pode ser baixado de novo com: python3 scripts/baixar_dados_tse.py <conjunto>
dados/tse/2026/*
!dados/tse/2026/boletim_urna/
!dados/tse/2026/correspondencias/
!dados/tse/2026/arquivos_urna/
!dados/tse/2026/totalizacao/
!dados/tse/2026/presidente/
dados/tse/2026/boletim_urna/*
!dados/tse/2026/boletim_urna/2turno/
# 1º turno: 4,8 GB (SP sozinho tem 1,4 GB). Versionamos só os hashes oficiais; a tabela por seção está em dados/derivados/
!dados/tse/2026/boletim_urna/1turno/
dados/tse/2026/boletim_urna/1turno/*.zip
# Pacotes das urnas: versionados em partes de 90 MB; o .zip inteiro é remontado localmente
dados/tse/2026/arquivos_urna/2turno/*.zip
dados/tse/2022/*
!dados/tse/2022/presidente/
!dados/tse/2022/boletim_urna/
dados/tse/2022/boletim_urna/*
!dados/tse/2022/boletim_urna/2turno/
*.part
__pycache__/
# Parciais por UF da recontagem nacional (o resultado consolidado fica em dados/derivados/recontagem_rdv_2t_2026.csv.gz)
dados/derivados/recontagem_rdv/
